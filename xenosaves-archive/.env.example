# ── XenoSaves Archive configuration ──────────────────────────────────────────
# Copy to .env on the SERVER only. Never ship any of these values in a desktop/browser build.

# New, dedicated database (do NOT point this at any existing XenoSaves/Supabase project)
POSTGRES_PASSWORD=change-me-long-random
# DATABASE_URL is set by docker-compose; for bare-metal runs:
# DATABASE_URL=postgres://xsa:change-me@localhost:5432/xsa

# Object storage — Cloudflare R2 (private bucket; S3-compatible API)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=xenosaves-archive
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Objects up to this size are re-downloaded and re-hashed after upload (read-back verification)
S3_VERIFY_MAX_BYTES=67108864

# Secrets (generate with: openssl rand -hex 32)
ADMIN_TOKEN=
SIGNING_SECRET=

# API
PORT=8787
PUBLIC_BASE_URL=https://archive.example.com
SIGNED_URL_TTL_SECONDS=300
CATALOG_REQUIRES_API_KEY=false
DOWNLOAD_REQUIRES_API_KEY=true
# Serve files whose malware scan did not run (keep false in production; clamd is in docker-compose)
SERVE_UNSCANNED_FILES=false

# Crawler identity / politeness
CRAWLER_CONTACT_URL=https://archive.example.com/about
# GITHUB_TOKEN=            # optional: higher GitHub API limits for future search-based discovery
# GOOGLE_API_KEY=          # optional: Google Drive v3 API for public files/folders

# Limits
MAX_DOWNLOAD_BYTES=2147483648
MAX_UNCOMPRESSED_BYTES=8589934592
MAX_ARCHIVE_ENTRIES=50000
MAX_COMPRESSION_RATIO=1000

# Worker
WORKER_LEASE_SECONDS=300
SCHEDULER_ENABLED=true
# ALERT_WEBHOOK_URL=        # e.g. a Discord webhook for storage-threshold alerts

# Official access tokens a site granted for archiving (referenced by a source's config.auth.env)
# TTG_ARCHIVE_TOKEN=
