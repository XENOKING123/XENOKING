{
  "name": "xenosaves-archive",
  "version": "0.1.0",
  "private": true,
  "description": "Independent PS4/PS5 save-archive collection server: discovery, authorized downloading, verification, content-addressed storage (R2/S3), metadata catalog, admin dashboard and download API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "xsa": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "cli": "tsx src/cli.ts",
    "migrate": "tsx src/cli.ts migrate",
    "serve": "tsx src/cli.ts serve",
    "work": "tsx src/cli.ts work"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/lib-storage": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "fastify": "^5.12.8",
    "megajs": "^1.3.10",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "undici": "^8.12.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
